# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
DATABASE_PATH=./data/postyar.sqlite

# Auth / sharing
AUTH_PUBLIC_URL=https://your-domain.example
# Comma-separated extra browser origins (optional)
CORS_ORIGINS=
# Show invite/magic URLs in API so you can paste to a teammate (no SMTP required)
SHARE_INVITE_LINKS=1
# Passwordless quick login — keep 0 in production
ALLOW_DEV_LOGIN=0
# Owner key: lets a workspace ADMIN sign in with email + this key when there is no SMTP.
# Generate with: openssl rand -base64 24
AUTH_OWNER_KEY=

# Telegram (never commit real secrets)
TELEGRAM_BOT_TOKEN=
# Ops notify chat. File ingest also includes every group/channel the bot is in.
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE=https://api.telegram.org
# Optional separate chat for ops alerts (defaults to TELEGRAM_CHAT_ID)
TELEGRAM_NOTIFY_CHAT_ID=
# Reminder job interval (ms)
REMINDER_INTERVAL_MS=60000

# Live Instagram page sync (public data, no password).
# Scheduler tick (min 60000) — syncs at most ONE due page per tick.
IG_SYNC_TICK_MS=300000
# Minimum gap between automatic syncs of the same page (min 300000)
IG_SYNC_INTERVAL_MS=1800000
# Set to 1 to disable automatic sync (manual "Sync now" keeps working)
IG_SYNC_DISABLED=0
# HMAC secret for the signed media proxy (defaults to TELEGRAM_WEBHOOK_SECRET)
MEDIA_PROXY_SECRET=

# Optional Instagram web session cookie (must include sessionid=).
# Without it, in-app page search still works via typed handle, saved pages, and public catalogs.
# INSTAGRAM_SESSION_COOKIE=

# Optional Instagram Insights connectors (never commit real keys / never store IG passwords).
# Public profile analysis works without these. Reach/Impressions need a connected Business account.
# SUPERMETRICS_API_KEY=
# SUPERMETRICS_IG_ACCOUNT=
# META_IG_ACCESS_TOKEN=
# META_IG_USER_ID=

# Frontend (leave empty when UI is served by the same Node server)
VITE_API_URL=
